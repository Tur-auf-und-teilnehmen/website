    :root {
      --bg: #0d0f12;
      --panel: #15191e;
      --panel-2: #101318;
      --text: #f3f0e8;
      --muted: #a8adb4;
      --line: #2a3038;
      --accent: #f1b24b;
      --accent-soft: rgba(241,178,75,.12);
      --max: 1120px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(circle at 85% 5%, rgba(241,178,75,.08), transparent 28rem),
        linear-gradient(180deg, #0d0f12 0%, #0a0c0f 100%);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6;
    }

    a { color: inherit; }
    .wrap { width: min(calc(100% - 40px), var(--max)); margin: 0 auto; }

    header {
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(14px);
      background: rgba(13,15,18,.78);
      border-bottom: 1px solid rgba(255,255,255,.06);
    }

    nav {
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      font-weight: 800;
      letter-spacing: -.02em;
      text-decoration: none;
    }

    .navlinks { display: flex; gap: 20px; align-items: center; }
    .navlinks a {
      color: var(--muted);
      text-decoration: none;
      font-size: .94rem;
    }
    .navlinks a:hover { color: var(--text); }

    .social-links {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-left: 2px;
    }
    .social-link {
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 9px;
      color: var(--muted);
      background: rgba(255,255,255,.025);
      transition: .18s ease;
    }
    .social-link:hover {
      color: var(--accent);
      border-color: rgba(241,178,75,.55);
      background: var(--accent-soft);
      transform: translateY(-1px);
    }
    .social-link svg {
      width: 19px;
      height: 19px;
      display: block;
    }

    .hero {
      min-height: 72vh;
      display: grid;
      align-items: center;
      padding: 90px 0 56px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--accent);
      font-size: .82rem;
      text-transform: uppercase;
      letter-spacing: .15em;
      font-weight: 800;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--accent);
    }

    h1 {
      max-width: 920px;
      margin: 22px 0 24px;
      font-size: clamp(3rem, 8vw, 7.2rem);
      line-height: .93;
      letter-spacing: -.065em;
    }

    .lead {
      max-width: 720px;
      color: #c8ccd1;
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      margin: 0;
    }

    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 18px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: transparent;
      color: inherit;
      text-decoration: none;
      font: inherit;
      font-weight: 750;
      cursor: pointer;
      transition: .18s ease;
    }
    .btn.primary { background: var(--accent); color: #17120a; border-color: var(--accent); }
    .btn:hover { transform: translateY(-2px); }
    .mobile-label { display: none; }

    .hero-media {
      display: grid;
      grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
      gap: clamp(28px, 5vw, 72px);
      align-items: center;
      padding-bottom: 54px;
    }
    .hero-reel {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel-2);
      box-shadow: 0 28px 80px rgba(0,0,0,.28);
    }
    .hero-reel video {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 9 / 16;
      object-fit: cover;
      background: #090b0e;
    }
    .hero-media-copy { max-width: 560px; }
    .hero-media-copy h2 {
      margin: 12px 0 18px;
      font-size: clamp(2.2rem, 5vw, 4.8rem);
      line-height: .95;
      letter-spacing: -.05em;
    }
    .hero-media-copy p {
      margin: 0;
      color: #c8ccd1;
      font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    }
    .hero-media-copy .event-meta {
      margin-top: 24px;
      color: var(--text);
      font-weight: 750;
    }

    .visit-media {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: clamp(36px, 6vw, 88px);
      align-items: center;
      padding: 18px 0 64px;
    }
    .visit-reel {
      order: 2;
      width: 260px;
      justify-self: end;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel-2);
      box-shadow: 0 24px 60px rgba(0,0,0,.24);
    }
    .visit-reel video {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 9 / 16;
      object-fit: cover;
      background: #090b0e;
    }
    .visit-copy {
      order: 1;
      max-width: 620px;
    }
    .visit-copy h2 {
      margin: 12px 0 18px;
      font-size: clamp(2.1rem, 3.8vw, 3.8rem);
      line-height: .96;
      letter-spacing: -.05em;
    }
    .visit-copy p {
      margin: 0;
      color: #c8ccd1;
      font-size: clamp(1.05rem, 1.8vw, 1.22rem);
    }
    .visit-copy .hero-actions { margin-top: 24px; }

    .visual { padding: 34px 0 0; }
    .visual-frame {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel-2);
      box-shadow: 0 28px 80px rgba(0,0,0,.28);
    }
    .visual-frame img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
    }

    section { padding: 76px 0; }
    .section-head { max-width: 760px; margin-bottom: 32px; }
    .section-head h2 {
      margin: 8px 0 12px;
      font-size: clamp(2rem, 4vw, 3.6rem);
      line-height: 1;
      letter-spacing: -.045em;
    }
    .section-head p { color: var(--muted); margin: 0; font-size: 1.05rem; }

    .statement {
      padding: 32px;
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      background: linear-gradient(135deg, var(--accent-soft), transparent 65%);
      border-radius: 10px;
      font-size: clamp(1.25rem, 3vw, 2rem);
      font-weight: 750;
      letter-spacing: -.025em;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(250px, 340px);
      gap: clamp(40px, 7vw, 96px);
      align-items: center;
    }
    .hero-copy { min-width: 0; }
    .hero-person {
      justify-self: end;
      width: min(100%, 340px);
    }
    .hero-person-photo {
      overflow: hidden;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel-2);
      box-shadow: 0 28px 80px rgba(0,0,0,.28);
    }
    .hero-person-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-person-caption {
      margin-top: 12px;
      display: grid;
      gap: 2px;
      color: var(--muted);
      font-size: .92rem;
    }
    .hero-person-caption strong {
      color: var(--text);
      font-size: 1rem;
    }

    .topics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .topic {
      border: 1px solid var(--line);
      background: linear-gradient(160deg, var(--panel), var(--panel-2));
      border-radius: 10px;
      overflow: hidden;
      transition: border-color .18s ease, transform .18s ease;
    }
    .topic:hover { border-color: #404853; }
    .topic[open] { border-color: rgba(241,178,75,.55); }

    .topic summary {
      list-style: none;
      cursor: pointer;
      min-height: 92px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 22px 24px;
      font-size: clamp(1.15rem, 2.4vw, 1.55rem);
      font-weight: 760;
      user-select: none;
    }
    .topic summary::-webkit-details-marker { display: none; }
    .topic summary::after {
      content: "+";
      color: var(--accent);
      font-size: 1.55rem;
      line-height: 1;
      font-weight: 400;
      transition: transform .18s ease;
    }
    .topic[open] summary::after { transform: rotate(45deg); }

    .topic-content {
      padding: 0 24px 24px;
      color: var(--muted);
      max-width: 42rem;
      font-size: 1rem;
    }
    .topic-content p { margin: 0; }
    .poll-link {
      display: inline-block;
      margin-top: 10px;
      color: var(--accent);
      font-weight: 750;
      text-decoration: none;
    }
    .poll-link:hover { text-decoration: underline; }

    .hint {
      margin-top: 18px;
      color: var(--muted);
      font-size: .94rem;
    }

    .event {
      display: grid;
      grid-template-columns: 1.4fr .6fr;
      gap: 18px;
      align-items: stretch;
    }
    .event-main, .event-side {
      border: 1px solid var(--line);
      background: var(--panel-2);
      border-radius: 10px;
      padding: 28px;
    }
    .event-main h3 { font-size: 1.8rem; margin: 4px 0 10px; }
    .event-main p, .event-side p { color: var(--muted); }
    .event-side strong { color: var(--accent); font-size: 1.15rem; }

    .event-dialog {
      width: min(calc(100% - 32px), 760px);
      max-height: min(86vh, 900px);
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 14px;
      color: var(--text);
      background: #101318;
      box-shadow: 0 32px 100px rgba(0,0,0,.58);
      overflow: hidden;
    }
    .event-dialog::backdrop {
      background: rgba(5,7,10,.78);
      backdrop-filter: blur(6px);
    }
    .event-dialog-shell {
      max-height: min(86vh, 900px);
      overflow-y: auto;
    }
    .event-dialog-head {
      position: sticky;
      top: 0;
      z-index: 2;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      padding: 24px 26px 18px;
      border-bottom: 1px solid var(--line);
      background: rgba(16,19,24,.96);
      backdrop-filter: blur(12px);
    }
    .event-dialog-head h2 {
      margin: 4px 0 0;
      font-size: clamp(1.55rem, 4vw, 2.3rem);
      line-height: 1;
      letter-spacing: -.035em;
    }
    .event-dialog-close {
      flex: 0 0 auto;
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: rgba(255,255,255,.025);
      color: var(--muted);
      font: inherit;
      font-size: 1.3rem;
      cursor: pointer;
    }
    .event-dialog-close:hover {
      color: var(--text);
      border-color: rgba(241,178,75,.55);
    }
    .event-dialog-body {
      padding: 26px;
      color: #c8ccd1;
    }
    .event-dialog-body h3 {
      margin: 28px 0 10px;
      color: var(--text);
      font-size: 1.18rem;
    }
    .event-dialog-body h3:first-child { margin-top: 0; }
    .event-dialog-body p { margin: 0 0 14px; }
    .event-dialog-body ul {
      margin: 8px 0 18px;
      padding-left: 22px;
    }
    .event-dialog-body strong { color: var(--text); }
    .event-dialog-body .dialog-note {
      margin-top: 26px;
      padding: 18px;
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: 9px;
      background: var(--accent-soft);
    }
    .event-dialog-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }

    footer {
      padding: 42px 0 58px;
      border-top: 1px solid var(--line);
      color: var(--muted);
    }
    footer strong { color: var(--text); }
    .legal-links {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 12px;
      font-size: .92rem;
    }
    .legal-links a {
      color: var(--muted);
      text-decoration: none;
    }
    .legal-links a:hover {
      color: var(--text);
      text-decoration: underline;
    }

    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 38px;
      }
      .hero-person {
        justify-self: start;
        width: min(100%, 320px);
      }
      .visit-media,
      .hero-media {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .visit-reel {
        order: 1;
        width: min(100%, 380px);
        justify-self: start;
      }
      .visit-copy {
        order: 2;
        max-width: 680px;
      }
      .hero-reel { width: min(100%, 430px); }
      .hero-media-copy { max-width: 680px; }
    }

    @media (max-width: 780px) {
      nav { min-height: 60px; }
      .navlinks > a { display: none; }
      .navlinks { gap: 8px; }
      .social-links { gap: 6px; }
      .social-link { width: 36px; height: 36px; }
      .hero { min-height: auto; padding-top: 72px; padding-bottom: 44px; }
      .hero .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .hero .hero-actions .btn { width: 100%; }
      .hero-media-copy .hero-actions {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
      }
      .hero-media-copy .hero-actions .btn { width: 100%; }
      .visit-copy .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .visit-copy .hero-actions .btn { width: 100%; }
      .visit-media { padding-bottom: 48px; }
      .visit-reel { width: 100%; border-radius: 10px; }
      .hero-media { padding-bottom: 34px; }
      .hero-reel { width: 100%; border-radius: 10px; }
      .visual { padding-top: 26px; }
      .visual-frame { border-radius: 10px; }
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 34px;
      }
      .hero-person {
        justify-self: start;
        width: min(100%, 320px);
      }
      .topics { grid-template-columns: 1fr; }
      .topic summary { min-height: 76px; padding: 18px 20px; }
      .topic-content { padding: 0 20px 20px; }
      .event { grid-template-columns: 1fr; }
      .event-main .hero-actions {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
      }
      .event-main .hero-actions .btn {
        width: 100%;
      }
      section { padding: 58px 0; }
      .vote-cta {
        width: 100%;
        min-height: 52px;
        padding: 0 18px;
        border-radius: 10px;
        font-size: 1rem;
        line-height: 1.2;
        text-align: center;
        white-space: nowrap;
      }
      .vote-cta .desktop-label { display: none; }
      .vote-cta .mobile-label { display: inline; }
      .event-dialog {
        width: min(calc(100% - 20px), 760px);
        max-height: 92vh;
        border-radius: 10px;
      }
      .event-dialog-shell { max-height: 92vh; }
      .event-dialog-head { padding: 20px 18px 16px; }
      .event-dialog-body { padding: 20px 18px 24px; }
      .event-dialog-actions {
        display: grid;
        grid-template-columns: 1fr;
      }
      .event-dialog-actions .btn { width: 100%; }
    }
