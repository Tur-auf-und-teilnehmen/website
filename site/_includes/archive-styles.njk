
/* Archive and event detail pages extend the existing home stylesheet. */
.archive-main { min-height: 65vh; }
.archive-intro { padding: 84px 0 34px; }
.archive-intro h1 {
  /* Keep long archive and event titles within the available content width. */
  max-width: 100%;
  font-size: clamp(2.5rem, 5.8vw, 5.5rem);
  line-height: 1.06;
  letter-spacing: -.05em;
  margin: 16px 0 22px;
  text-wrap: balance;
  overflow-wrap: anywhere;
}
.archive-intro .lead { max-width: 840px; }
/* Breadcrumb and eyebrow must occupy separate rows (both used to be inline-flex). */
.archive-breadcrumb { display:flex;width:fit-content;gap:10px;align-items:center;
  color:var(--muted);font-size:.95rem;text-decoration:none;margin:0 0 24px; }
.archive-intro .eyebrow { display:flex;width:fit-content;max-width:100%;flex-wrap:wrap; }
.archive-breadcrumb:hover { color:var(--accent); }
.archive-label { margin:22px 0 10px;color:var(--accent);font-weight:800;letter-spacing:.08em; }
.archive-facts { display:flex;gap:20px;flex-wrap:wrap;margin:18px 0 20px;color:var(--muted); }
.archive-facts strong { color:var(--text); }
.archive-event-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:26px; }
.archive-event-card { display:grid;grid-template-columns:minmax(0, 230px) 1fr;
  background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden; }
.archive-event-card img { display:block;width:100%;height:100%;min-height:240px;object-fit:cover; }
.archive-event-card-content { padding:28px;align-self:center; }
.archive-event-card h3 { margin:8px 0 12px;font-size:clamp(1.55rem,2.8vw,2.2rem);line-height:1.15; }
.archive-event-card p { color:var(--muted); }
.archive-event-card .btn { margin-top:10px; }
.archive-intro--event { padding-bottom:20px; }
.archive-visit { padding:42px 0 62px; }
.archive-visit .visit-reel { width:260px; }
.archive-visit .visit-copy p { margin-bottom:18px; }
.archive-gallery { display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px; }
.archive-gallery-card { min-width:0;overflow:hidden;background:var(--panel);
  border:1px solid var(--line);border-radius:14px; }
.archive-gallery-card video,.archive-gallery-card img { display:block;
  width:100%;aspect-ratio:9 / 13;object-fit:contain;background:#090b0e; }
.archive-gallery-info { padding:22px; }
.archive-gallery-info h3 { margin:0 0 6px;font-size:1.22rem; }
.archive-gallery-info p { margin:0;color:var(--muted); }
.archive-section-note {color:var(--muted);margin-top:8px;}
.archive-prose {max-width:820px;color:#c8ccd1;}
.archive-prose h2,.archive-prose h3 {color:var(--text);font-size:clamp(1.4rem,3vw,1.8rem);line-height:1.15;margin:32px 0 14px;}
.archive-prose p,.archive-prose li {font-size:1.05rem;line-height:1.75;}
.archive-prose a {color:var(--accent);}
.archive-prose .dialog-note {padding:22px;border-left:3px solid var(--accent);
  background:var(--panel);border-radius:10px;}
.archive-links {display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:22px;}
.archive-links .btn { font-size:.95rem; }
.archive-divider {height:1px;background:var(--line);margin:28px 0 0;}
@media(max-width:780px) {
  .archive-intro {padding:42px 0 20px;}
  .archive-intro h1 {font-size:clamp(2.2rem, 8.5vw, 4rem);line-height:1.1;}
  .archive-breadcrumb {margin-bottom:20px;}
  .archive-event-card {grid-template-columns:1fr;}
  .archive-event-card img {max-height:360px;}
  .archive-visit .visit-reel {width:min(100%,340px);}
  .archive-gallery {grid-template-columns:1fr;}
  .archive-gallery-card video,.archive-gallery-card img {aspect-ratio:9/12;}
}
